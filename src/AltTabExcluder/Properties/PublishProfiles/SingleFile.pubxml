<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained single-file publish profile. Produces a single
  AltTabExcluder.exe that includes the .NET runtime — no .NET installation
  required on the target machine.

  Compression is enabled to reduce the bundled runtime size. Trimming is
  not available (WinForms uses reflection heavily; the SDK blocks it).
  ReadyToRun was evaluated but increased the EXE size by ~4 MB for a
  negligible startup gain on a small tray app — not worth the trade.

  Usage: dotnet publish -c Release -p:PublishProfile=SingleFile
  Output: bin\x64\Release\net8.0-windows\win-x64\publish\AltTabExcluder.exe
-->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
